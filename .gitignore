# Terraform working directory and state
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
.terraformrc
terraform.rc

# Plans and generated outputs
*.tfplan
*.plan
plan.out
terraform.out

# Local variable files (keep only the example)
*.tfvars
*.tfvars.json
!terraform.tfvars.example
!**/terraform.tfvars.example

# Credentials, keys and local environment files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials
credentials.*
secrets.*
*.secret

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Temporary backups and local test artifacts
*.bak
*.bak-*
*.backup

# Local secret scanner reports
gitleaks-report.*

# Python dashboard and generated reports
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dashboard/reports/*.json
!dashboard/reports/.gitkeep
